# NOTEBOOK / PYTHON
# =========================
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.env
.venv/
venv/
.coverage

# =========================
# TOOL / TEMP
# =========================
.tmp/
_tmp/
.cache/
logs/
*.log

# =========================
# IDE / EDITOR
# =========================
.vscode/
.idea/
*.code-workspace

# =========================
# OS
# =========================
.DS_Store
Thumbs.db

