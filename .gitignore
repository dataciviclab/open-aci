# CREDENTIALS (MAI)
# =========================
credentials.json
service_account.json
*.key
*.pem

# =========================
# DATI RAW scaricati (non versionare)
# =========================
datasets/raw/
**/*.parquet
!registry/**
!dashboard/**

# =========================
# LEGACY / SANDBOX
# =========================
_legacy/
